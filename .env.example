# Vercel Deployment & Server Environment Variables

# Search & Retrieval APIs (At least one recommended for live web data)
TAVILY_API_KEY=tvly-your_tavily_key_here
BRAVE_API_KEY=BSAu_your_brave_key_here

# LLM Inference APIs
GROQ_API_KEY=gsk_your_groq_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Deployment settings
DISABLE_LOCAL_OLLAMA=true
